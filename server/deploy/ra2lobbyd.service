# Example systemd unit for an explicitly approved OpenRA2 lobby deployment.
# This file is NEVER installed/enabled by CI or deploy/release.sh.
# For new services, stage a verified binary under /opt/openra2-lobby/current.
# Do not replace another app's service. Follow docs/S0.1F-PRODUCTION-READINESS.md.
[Unit]
Description=OpenRA2 central lobby and UDP game relay (ra2lobbyd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/openra2-lobby/ra2lobbyd.env
ExecStartPre=/opt/openra2-lobby/current/ra2lobbyd --check-config
ExecStart=/opt/openra2-lobby/current/ra2lobbyd
WorkingDirectory=/opt/openra2-lobby/current
DynamicUser=yes
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
LimitNOFILE=8192
UMask=0077
# Restrict the daemon to sockets and read-only staged releases.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
