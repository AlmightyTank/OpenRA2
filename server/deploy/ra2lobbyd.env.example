# Example settings for the dedicated OpenRA2 lobby service.
# Copy OUTSIDE the Git repository to /etc/openra2-lobby/ra2lobbyd.env
# with owner root and mode 0600. Never commit real secrets.
#
# Use a dedicated host or allocated ports: do not override another service.
RA2_LISTEN=:50000
RA2_V3=:50001
RA2_RELAY_PORTS=50100-50999
RA2_ADMIN=127.0.0.1:8080
RA2_SERVER_NAME=OpenRA2 Multiplayer
RA2_MOTD=Welcome to OpenRA2
RA2_MAX_ROOMS=500
RA2_MAX_ROOMS_PER_IP=3
RA2_MAX_CONNS_PER_IP=5
RA2_TUNNEL_MAX_CLIENTS=200
RA2_TUNNEL_IP_LIMIT=8
RA2_ALLOW_LOOPBACK=0
# Set only if required for external address advertisement behind 1:1 NAT.
# RA2_PUBLIC_IP=203.0.113.10
#
# For private operator dashboard access generate with:
#   openssl rand -hex 32
# Assign it privately, NOT here in the repository:
# RA2_ADMIN_TOKEN=<your-private-random-value>
# Optional bans file readable by the restricted daemon account:
# RA2_BAN_FILE=/etc/openra2-lobby/bans.json
